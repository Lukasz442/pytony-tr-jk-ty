def shop(player):
    while True:
        option = input(
            "\n--- SHOP ---\n"
            f"Gold: {player['gold']}\n"
            "1 +100 hp (20 gold)\n"
            "2 +10 damage (100 gold)\n"
            "3 +30 mana (80 gold)\n"
            "4 upgrade rest (120 gold)\n"
            "5 exit\n"
            "- "
        )

        if option == "1":
            if player["gold"] >= 20:
                player["gold"] -= 20
                player["hp"] += 100

                print("You used potion")
                print("+100 HP")

            else:
                print("Not enough gold")

        elif option == "2":
            if player["gold"] >= 100:
                player["gold"] -= 100
                player["damage"] += 10
                print("Damage upgraded")
            else:
                print("Not enough gold")

        elif option == "3":
            if player["gold"] >= 80:
                player["gold"] -= 80
                player["mana"] += 30
                print("Mana increased")
            else:
                print("Not enough gold")

        elif option == "4":
            if player["gold"] >= 120:
                player["gold"] -= 120
                player["rest_heal_bonus"] = player.get("rest_heal_bonus", 0) + 10
                player["rest_mana_bonus"] = player.get("rest_mana_bonus", 0) + 15
                print("Rest upgraded")
            else:
                print("Not enough gold")

        elif option == "5":
            break

        else:
            print("Wrong option")




